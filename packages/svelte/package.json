{
  "name": "@loidolt/theme-svelte",
  "version": "0.4.0",
  "description": "Accessible Svelte 5 components for Loidolt applications",
  "license": "MIT",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "svelte-package -i src/lib -o dist && cp src/styles.css dist/styles.css",
    "prepack": "npm run build",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run && vitest run --config vitest.config.ssr.ts",
    "test:coverage": "vitest run --coverage",
    "test:a11y": "vitest run tests/a11y.test.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@loidolt/theme-styles": "^0.4.0",
    "@loidolt/theme-tokens": "^0.4.0",
    "bits-ui": "^2.19.0"
  },
  "peerDependencies": {
    "svelte": "^5.33.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/svelte": "^5.2.8",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^27.0.0",
    "rimraf": "^6.0.1",
    "svelte": "^5.56.10",
    "svelte-check": "^4.3.2",
    "typescript": "^6.0.3",
    "vitest": "^4.0.0",
    "vitest-axe": "^0.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loidolt/loidolt-theme.git",
    "directory": "packages/svelte"
  }
}
