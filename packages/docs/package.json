{
  "name": "@loidolt/theme-docs",
  "version": "0.9.1",
  "description": "Accessible Markdown documentation components for Loidolt applications",
  "license": "MIT",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "svelte-package -i src/lib -o dist",
    "prepack": "npm run build",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run && vitest run --config vitest.config.ssr.ts",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@loidolt/theme-svelte": "^0.9.1",
    "@loidolt/theme-tokens": "^0.9.1",
    "marked": "^18.0.0"
  },
  "peerDependencies": {
    "mermaid": "^11.0.0 || ^12.0.0",
    "shiki": "^3.0.0 || ^4.0.0",
    "svelte": "^5.33.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/svelte": "^5.2.8",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^27.0.0",
    "rimraf": "^6.0.1",
    "shiki": "^4.0.0",
    "svelte": "^5.56.10",
    "svelte-check": "^4.3.2",
    "typescript": "^6.0.3",
    "vitest": "^4.0.0",
    "vitest-axe": "^0.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loidolt/loidolt-theme.git",
    "directory": "packages/docs"
  },
  "peerDependenciesMeta": {
    "mermaid": {
      "optional": true
    },
    "shiki": {
      "optional": true
    }
  }
}
