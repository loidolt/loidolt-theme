{
  "name": "@loidolt/theme-styles",
  "version": "0.12.1",
  "description": "Base styles, fonts, accessibility helpers, and utilities for Loidolt applications",
  "license": "MIT",
  "type": "module",
  "style": "./src/index.css",
  "exports": {
    ".": "./src/index.css",
    "./core": "./src/core.css",
    "./tokens": "./src/tokens.css",
    "./dark": "./src/dark.css",
    "./dark-auto": "./src/dark-auto.css",
    "./presets/*": "./src/presets/*.css",
    "./base": "./src/base.css",
    "./accessibility": "./src/accessibility.css",
    "./utilities": "./src/utilities.css",
    "./components": "./src/components.css",
    "./components/*": "./src/components/*.css",
    "./fonts": "./src/fonts.css",
    "./fonts/*": "./src/fonts/*",
    "./standalone.css": "./dist/standalone.css",
    "./standalone-core.css": "./dist/standalone-core.css",
    "./fonts-embedded.css": "./dist/fonts-embedded.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node scripts/build-standalone.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@loidolt/theme-tokens": "^0.12.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loidolt/loidolt-theme.git",
    "directory": "packages/styles"
  }
}
