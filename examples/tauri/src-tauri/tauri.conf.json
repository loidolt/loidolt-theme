{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Theme Example",
  "version": "0.0.0",
  "identifier": "space.loidolt.theme.example",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Theme Example",
        "width": 960,
        "height": 680,
        "minWidth": 480,
        "minHeight": 360,
        "visible": false,
        "backgroundColor": "#ebe7dc",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["theme-example"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
