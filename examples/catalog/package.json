{
  "name": "@loidolt/theme-catalog",
  "version": "0.0.8",
  "private": true,
  "type": "module",
  "scripts": {
    "props": "node scripts/extract-props.mjs",
    "dev": "npm run props && vite --host 0.0.0.0",
    "build": "npm run props && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && vite build",
    "typecheck": "npm run props && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "npm run props && node scripts/check-integrity.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/mapbox": "^9.4.0",
    "@loidolt/theme-charts": "^0.10.0",
    "@loidolt/theme-docs": "^0.10.0",
    "@loidolt/theme-maps": "^0.10.0",
    "@loidolt/theme-styles": "^0.10.0",
    "@loidolt/theme-svelte": "^0.10.0",
    "@loidolt/theme-tokens": "^0.10.0",
    "echarts": "^6.0.0",
    "maplibre-gl": "^6.0.0",
    "mermaid": "^11.17.2",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "svelte": "^5.56.10",
    "svelte-check": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "wrangler": "^4.125.0"
  }
}
