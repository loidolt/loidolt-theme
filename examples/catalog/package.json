{
  "name": "@loidolt/theme-catalog",
  "version": "0.0.4",
  "private": true,
  "type": "module",
  "scripts": {
    "props": "node scripts/extract-props.mjs",
    "dev": "npm run props && vite --host 0.0.0.0",
    "build": "npm run props && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && vite build",
    "typecheck": "npm run props && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "npm run props && node scripts/check-integrity.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@loidolt/theme-svelte": "^0.6.0",
    "@loidolt/theme-styles": "^0.6.0",
    "@loidolt/theme-tokens": "^0.6.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "svelte": "^5.56.10",
    "svelte-check": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "wrangler": "^4.125.0"
  }
}
