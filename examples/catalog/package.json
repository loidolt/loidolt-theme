  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "svelte": "^5.56.10",
    "svelte-check": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  }
